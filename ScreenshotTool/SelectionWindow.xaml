<Window x:Class="ScreenshotTool.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenshotTool"
        mc:Ignorable="d"
        WindowStyle="None" WindowState="Maximized" AllowsTransparency="True" Background="#66000000">
    <Grid MouseDown="Grid_MouseDown" MouseUp="Grid_MouseUp" MouseMove="Grid_MouseMove" Background="Transparent" Cursor="Cross">
        <Rectangle x:Name="secimDikdortgeni"
                   Stroke="White"
                   StrokeThickness="2"
                   Fill="#33FF0000"
                   Visibility="Collapsed"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

    </Grid>
</Window>
